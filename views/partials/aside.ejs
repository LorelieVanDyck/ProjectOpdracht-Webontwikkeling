<aside class="sidebar">

    <h2 class="logo">
        <span class="logo-icon">🍜</span>
        <span class="logo-text">UrbanTaste</span>
    </h2>

    <!-- Enkel Zichtbaar Als ADMIN: Gebruikersnaam & Logout -->
    <% if (typeof user !== 'undefined' && user) { %>
        <div class="user-info">    
            <p>Ingelogd als: <strong><%= user.username %></strong></p>
            <form action="/logout" method="post">
                <button type="submit">Uitloggen</button>
            </form>
        </div>
    <% } %>

    <% if (showSearch) { %>
        <h3>Search</h3>

        <form method="GET" action="<%= searchAction %>">
            <input type="text" name="search_bar" placeholder="<%= searchPlaceholder || 'Zoek...' %>" value="<%= search || '' %>">
            <button type="submit">Zoek</button>
        </form>
    <% } %>

    
    <h3>Navigation</h3>

    <nav>
        <a href="/">Home</a>
        <a href="/streetfoods">Streetfoods</a>
        <a href="/vendors">Vendors</a>
    </nav>

</aside>